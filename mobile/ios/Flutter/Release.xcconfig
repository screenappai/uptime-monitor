#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

// Launcher / home-screen app name. OSS default; a rebranded build overrides
// APP_DISPLAY_NAME (e.g. to "Uptime Koala") via xcconfig or an xcodebuild
// build-setting argument.
APP_DISPLAY_NAME=Uptime Monitor

// Optional private brand overrides (git-ignored). When present, this file's
// APP_DISPLAY_NAME wins over the OSS default above. Absent in OSS builds.
#include? "BrandConfig.xcconfig"
